{
    "name": "is-media",
    "version": "1.0.0",
    "description": "social media and realtime chatting website",
    "main": "app.js",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "node src/server.js",
        "dev": "node --watch --env-file=.env src/server.js",
        "db:init": "node --env-file=.env src/scripts/initDb.js",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "author": "TheSolom",
    "license": "MIT",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.11.0",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "denque": "^2.1.0",
        "express": "^5.3.0",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "mysql2": "^3.24.6",
        "nodemailer": "^9.1.1",
        "socket.io": "^4.8.4",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "unrs-resolver@1.12.2": true
    },
    "lint-staged": {
        "**/*.js": [
            "prettier --write",
            "eslint --fix"
